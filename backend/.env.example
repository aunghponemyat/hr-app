# Copy to backend/.env. These are local development credentials only.
DATABASE_URL=mysql+pymysql://hr_user:hr_pass@127.0.0.1:3306/hr_app
TEST_DATABASE_URL=mysql+pymysql://hr_test:hr_test_pass@127.0.0.1:3307/hr_app_test

# Replace with a random secret of at least 32 characters before signing in.
JWT_SECRET_KEY=change-me-long-random
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT_IP=30
LOGIN_RATE_LIMIT_EMPLOYEE=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

APP_ENV=development
APP_TIMEZONE=Asia/Bangkok
WORKING_WEEKDAYS=0,1,2,3,4
HALF_DAY_THRESHOLD_HOURS=4
MAX_GPS_ACCURACY_M=100
MAX_REPORT_RANGE_DAYS=366
LEAVE_MAX_DAYS_PER_REQUEST=30
LEAVE_BACKDATE_DAYS=7
EMPLOYEE_ID_PREFIX=EMP
EMPLOYEE_ID_PAD=4
CORS_ORIGINS=http://localhost:5173
